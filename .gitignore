# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Databases & Runtime State (contains user session cookies and auth tokens)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-journal
!data/.gitkeep

# Media & Uploads (exclude large media files)
uploads/*
!uploads/.gitkeep
videos/*
!videos/.gitkeep

# Logs & temp files
*.log
*.tmp
*.pid
.cache/

# IDE / Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
